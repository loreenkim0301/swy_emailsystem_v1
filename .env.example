# Supabase 설정
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# EmailJS 설정 (선택사항)
# 개발 환경에서 EmailJS 설정을 관리하려면 아래 값을 입력하세요.
# 비워두면 UI에서 직접 입력할 수 있습니다.
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# 사용법:
# 1. 이 파일을 .env로 복사하세요
# 2. your_supabase_project_url_here를 실제 Supabase URL로 교체하세요
# 3. your_supabase_anon_key_here를 실제 Supabase Anon Key로 교체하세요
# 4. (선택) EmailJS 설정 값을 입력하세요 (EmailJS Dashboard에서 확인 가능)
# 5. .env 파일은 절대 Git에 커밋하지 마세요!